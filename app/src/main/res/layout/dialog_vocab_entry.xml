<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/vocab_canonical">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/vocab_canonical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"/>
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="@string/vocab_aliases">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/vocab_aliases"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:hint="h come, hcom"/>
    </com.google.android.material.textfield.TextInputLayout>

    <CheckBox
        android:id="@+id/vocab_enabled"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/vocab_enabled"
        android:checked="true"/>

    <CheckBox
        android:id="@+id/vocab_fuzzy"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/vocab_fuzzy"/>
</LinearLayout>
